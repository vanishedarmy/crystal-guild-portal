# Optional no-npm deployment: requires complete verified Web/frontend/dist
# from the v1.9.7 Web 1of2.zip, or a successful compatible source build.
# Dockerfile.prebuilt.dockerignore deliberately retains prebuilt dist assets.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOSTED_PORTAL_HOST=0.0.0.0 \
    HOSTED_PORTAL_PORT=8080 \
    HOSTED_PORTAL_STATIC_DIR=frontend/dist
WORKDIR /app
COPY crystal_guild /app/crystal_guild
COPY run_hosted_portal.py /app/run_hosted_portal.py
COPY frontend/dist /app/frontend/dist
COPY ARTWORK_V197_CHECKSUMS.json /app/ARTWORK_V197_CHECKSUMS.json
COPY tools/artwork_recovery.py /app/tools/artwork_recovery.py
RUN test -s /app/frontend/dist/index.html && python /app/tools/artwork_recovery.py check --root /app --target dist --fast
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; p=os.getenv('PORT',os.getenv('HOSTED_PORTAL_PORT','8080')); urllib.request.urlopen('http://127.0.0.1:'+p+'/api/health',timeout=3)"
CMD ["python", "run_hosted_portal.py"]
