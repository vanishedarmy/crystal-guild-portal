# Required secret. Generate locally with generate_portal_sync_key.bat.
PORTAL_SYNC_KEY=

# Optional hosted settings.
# Most hosts provide PORT automatically; Crystal Guild honors it.
HOSTED_PORTAL_DB=crystal_guild_hosted.db
HOSTED_PORTAL_ACCESS_LOG=false

# Portal UI switches LIVE to OFFLINE after this many seconds without a sync manifest heartbeat.
PORTAL_SYNC_STALE_SECONDS=90

# Portal Actions Phase 4 — Sign in with Twitch
# Register this exact callback URL in the Twitch Developer Console.
PORTAL_TWITCH_CLIENT_ID=
PORTAL_TWITCH_CLIENT_SECRET=
PORTAL_TWITCH_REDIRECT_URI=https://your-crystal-guild-site.example/auth/twitch/callback

# Secure cookies should remain enabled on HTTPS production hosting.
PORTAL_AUTH_COOKIE_SECURE=true
PORTAL_SESSION_TTL_SECONDS=604800
PORTAL_OAUTH_STATE_TTL_SECONDS=600

# Secure action relay. Portal Action protocol 14; the Bot remains authoritative for every player mutation.
PORTAL_ACTIONS_ENABLED=true
PORTAL_ACTION_LEASE_SECONDS=30
